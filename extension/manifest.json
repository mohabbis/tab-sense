{
  "manifest_version": 3,
  "name": "Tab-Sense",
  "version": "0.2.0",
  "description": "Automatically group your open Chrome tabs by project or topic.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab-Sense",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "group-now": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Group tabs in this window"
    },
    "ungroup-now": {
      "description": "Ungroup tabs in this window"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
